# --- Dependencias ---
node_modules/
# También como enlace simbólico (sin la barra solo se ignora la carpeta)
node_modules
jspm_packages/
web_cached_nodes/

# --- Salidas de producción (Build) ---
dist/
dist-ssr/
build/
*.local

# --- Archivos de entorno y secretos (¡NUNCA SUBIR!) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.*
# El ejemplo de variables de entorno sí se versiona (no contiene secretos,
# solo documenta qué variables existen y su valor por defecto local).
!.env.example

# --- Registros del sistema y errores (Logs) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Configuraciones de editores de código (IDE) ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Pruebas (Testing) ---
/coverage
.nyc_output

# --- Caché y herramientas de compilación ---
.eslintcache
.stylelintcache
.vite/
.parcel-cache
.turbo/
.nuxt/
.next/

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
